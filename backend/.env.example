# ============================================
# 英语辩论能力训练平台 - 环境配置模板
# ============================================
# 使用前: cp .env.example .env  然后填入真实值
# 不要将 .env 提交到版本控制系统！


# 1. 服务器端口
PORT=3000

# 2. 微信云开发环境ID
CLOUD_ENV=your-cloud-env-id

# 3. 微信小程序 AppID
APPID=your-wx-appid

# 4. 微信小程序 AppSecret（用于内容安全检测）
WX_SECRET=your-wx-app-secret

# 5. 豆包大模型 API
DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 6. 通义千问 API（备用）
QWEN_API_KEY=your-qwen-api-key
QWEN_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation

# 7. 百度语音评测 API
BAIDU_APP_ID=124151199
BAIDU_API_KEY=vDQjNHcq4uc716eMIfyMqkB0
BAIDU_SECRET_KEY=JcJEqFfvbez44KunP26y67mBxzUKt2FY

# 8. MVP 管理员账号（演示用）
ADMIN_PHONE=13800138000
ADMIN_CODE=123456