# ============================================
# 英语辩论能力训练平台 - 环境配置模板
# ============================================
# 使用前: cp .env.example .env  然后填入真实值
# 不要将 .env 提交到版本控制系统！


# 1. 服务器端口
PORT=3000

# 2. 微信云开发环境ID
CLOUD_ENV=your-cloud-env-id

# 3. 微信小程序 AppID
APPID=your-wx-appid

# 4. 微信小程序 AppSecret（用于内容安全检测）
WX_SECRET=your-wx-app-secret

# 5. 豆包大模型 API
DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 6. 通义千问 API（备用）
QWEN_API_KEY=your-qwen-api-key
QWEN_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation

# 7. 百度语音评测 API
BAIDU_APP_ID=your-baidu-app-id
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key

# 8. 腾讯云 API 密钥（迁移脚本 scripts/migrate-auth-to-cloud.js 使用）
# 获取：腾讯云控制台 → 访问管理 → API密钥管理 → 新建密钥
TCB_SECRET_ID=your-tcb-secret-id
TCB_SECRET_KEY=your-tcb-secret-key

# 9. 认证行为开关（可选）
# AUTH_DEV_CODE=0        # 接入真实短信后设为 0，关闭验证码接口回显
# AUTH_STORAGE=local     # 强制认证存储走本地JSON（回滚用）

# 10. PC 管理端初始化授权（逗号分隔手机号）
# 未存在于 users 集合的手机号，仅当出现在下面配置中才允许首次登录管理端
DEVELOPER_PHONES=your-developer-phone
TEACHER_PHONES=your-teacher-phone
# 开发者密钥 SHA-256（推荐使用开发者密钥登录，不要填写明文）
DEVELOPER_LOGIN_KEY_HASH=your-developer-login-key-sha256
