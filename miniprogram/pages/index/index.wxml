<view class="page-index">
  <!-- 用户信息 -->
  <view class="user-banner">
    <view class="user-avatar">{{userInfo.nickname ? userInfo.nickname[0] : '?'}}</view>
    <view class="user-info">
      <text class="user-name">{{userInfo.nickname || '未登录'}}</text>
      <text class="user-grade">{{userInfo.grade || '小学'}}</text>
    </view>
    <button class="login-btn" wx:if="{{!isLoggedIn}}" bindtap="handleLogin">登录</button>
  </view>

  <!-- 三大入口卡片 -->
  <view class="card-grid">
    <view class="entry-card card-speech" bindtap="goSpeech">
      <view class="card-icon">🎙️</view>
      <view class="card-title">跟读挑战</view>
      <view class="card-desc">听录音，模仿跟读，提升发音</view>
    </view>

    <view class="entry-card card-argument" bindtap="goPractice">
      <view class="card-icon">🧠</view>
      <view class="card-title">立论小能手</view>
      <view class="card-desc">AI帮你生成英语辩论稿</view>
    </view>

    <view class="entry-card card-growth" bindtap="goProfile">
      <view class="card-icon">📊</view>
      <view class="card-title">我的成就</view>
      <view class="card-desc">查看成长曲线与练习记录</view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-section">
    <text class="section-title">热门辩题</text>
    <scroll-view class="topic-scroll" scroll-x>
      <view class="topic-tag" wx:for="{{hotTopics}}" wx:key="id" bindtap="goTopicDetail" data-id="{{item._id}}">
        <text class="tag-title">{{item.title}}</text>
        <text class="tag-diff">{{item.difficulty}}</text>
      </view>
    </scroll-view>
  </view>
</view>