<view class="page-index">
  <view class="user-banner">
    <view class="user-avatar">{{userInfo.nickname ? userInfo.nickname[0] : '?'}}</view>
    <view class="user-info">
      <text class="user-name">{{userInfo.nickname || '小辩手'}}</text>
      <text class="user-grade">{{userInfo.grade || '小学'}}</text>
    </view>
  </view>

  <view class="assignment-banner" wx:if="{{currentAssignment}}">
    <text class="assignment-icon">📌</text>
    <view class="assignment-info">
      <text class="assignment-label">当前任务</text>
      <text class="assignment-title">{{currentAssignment.topic_title}}</text>
    </view>
  </view>

  <view class="card-grid">
    <view class="entry-card card-speech" bindtap="goTopicList">
      <view class="card-icon">🎙️</view>
      <view class="card-title">跟读挑战</view>
      <view class="card-desc">选择辩题，录音跟读，AI评分</view>
    </view>

    <view class="entry-card card-argument" bindtap="goPractice">
      <view class="card-icon">🧠</view>
      <view class="card-title">立论小能手</view>
      <view class="card-desc">AI帮你生成英语辩论稿</view>
    </view>

    <view class="entry-card card-portfolio" bindtap="goPortfolio">
      <view class="card-icon">📝</view>
      <view class="card-title">辩论作品集</view>
      <view class="card-desc">记录思考过程，AI评委专业反馈</view>
    </view>

    <view class="entry-card card-sparring" bindtap="goSparring">
      <view class="card-icon">🤖</view>
      <view class="card-title">AI对练</view>
      <view class="card-desc">不同风格AI对手，实时辩论训练</view>
    </view>

    <view class="entry-card card-tournament" bindtap="goTournament">
      <view class="card-icon">🏆</view>
      <view class="card-title">辩论赛事</view>
      <view class="card-desc">组织赛事、报名参赛、智能组队</view>
    </view>

    <view class="entry-card card-growth" bindtap="goProfile">
      <view class="card-icon">📊</view>
      <view class="card-title">我的成就</view>
      <view class="card-desc">查看成长曲线与练习记录</view>
    </view>
  </view>

  <view class="china-entry" bindtap="goChinaPractice">
    <view class="china-entry-copy">
      <text class="china-entry-kicker">辩论：思辨中国</text>
      <text class="china-entry-title">从中国故事找到论据</text>
      <text class="china-entry-desc">今天，从传统文化与现实经验换一个角度思考</text>
    </view>
    <text class="china-entry-arrow">›</text>
  </view>

  <view class="quick-section">
    <text class="section-title">热门辩题</text>
    <scroll-view class="topic-scroll" scroll-x>
      <view class="topic-tag" wx:for="{{hotTopics}}" wx:key="_id" bindtap="goTopicDetail" data-id="{{item._id}}" data-title="{{item.title}}">
        <text class="tag-title">{{item.title}}</text>
        <text class="tag-diff diff-{{item.difficulty}}">{{item.difficultyLabel}}</text>
      </view>
    </scroll-view>
  </view>
</view>
