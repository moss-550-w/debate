.page-practice {
  padding: 20rpx;
  background: #f0f2f5;
  min-height: 100vh;
}

.section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.picker-box {
  background: #f8fafc;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: 1px solid #e5e7eb;
}

.position-group {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.position-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 2px solid #e5e7eb;
  font-size: 28rpx;
}

.position-btn.active {
  background: #dbeafe;
  border-color: #2563eb;
  color: #2563eb;
}

.pos-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

/* 加载动画 */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 30rpx;
}

.loading-animation {
  display: flex;
  gap: 12rpx;
  margin-bottom: 30rpx;
}

.loading-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #2563eb;
  animation: bounce 1.4s infinite ease-in-out both;
}

.loading-dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

.loading-text {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.loading-hint {
  font-size: 26rpx;
  color: #6b7280;
}

/* 结果展示 */
.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 34rpx;
  font-weight: bold;
}

.result-position {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  background: #dbeafe;
  color: #2563eb;
}

.points-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.point-card {
  display: flex;
  gap: 16rpx;
  background: #f8fafc;
  padding: 20rpx;
  border-radius: 12rpx;
}

.point-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #2563eb;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
}

.point-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.point-title {
  font-size: 28rpx;
  font-weight: 600;
}

.point-sentence {
  font-size: 26rpx;
  color: #1f2937;
}

.point-translation {
  font-size: 24rpx;
  color: #6b7280;
}

.conclusion-card, .full-text-card {
  background: #f0f9ff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.conclusion-label, .full-text-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #2563eb;
  display: block;
  margin-bottom: 8rpx;
}

.conclusion-text, .full-text {
  font-size: 26rpx;
  line-height: 1.6;
}

.action-bar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.primary-btn {
  background: #2563eb;
  color: white;
  border: none;
  border-radius: 40rpx;
  padding: 24rpx;
  font-size: 30rpx;
  text-align: center;
}

.outline-btn {
  background: white;
  color: #2563eb;
  border: 2px solid #2563eb;
  border-radius: 40rpx;
  padding: 22rpx;
  font-size: 30rpx;
  text-align: center;
}