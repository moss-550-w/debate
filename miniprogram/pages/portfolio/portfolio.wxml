<view class="page-portfolio">

  <!-- ===== 顶部 Tab + 添加按钮 ===== -->
  <view class="top-bar">
    <view class="tab-nav">
      <view class="tab-item {{activeTab === 'records' ? 'active' : ''}}" bindtap="switchTab" data-tab="records">
        <text class="tab-text">思考记录</text>
      </view>
      <view class="tab-item {{activeTab === 'analysis' ? 'active' : ''}}" bindtap="switchTab" data-tab="analysis">
        <text class="tab-text">风格分析</text>
      </view>
    </view>
    <button class="add-btn" bindtap="openForm">+ 记录</button>
  </view>

  <!-- ===== 思考记录列表 ===== -->
  <view wx:if="{{activeTab === 'records'}}">

    <scroll-view class="filter-bar" scroll-x enable-flex>
      <view class="filter-chip {{filterType === '' ? 'active' : ''}}" bindtap="filterByType" data-type="">全部</view>
      <view class="filter-chip {{filterType === 'case' ? 'active' : ''}}" bindtap="filterByType" data-type="case">完整论点</view>
      <view class="filter-chip {{filterType === 'argument' ? 'active' : ''}}" bindtap="filterByType" data-type="argument">论点片段</view>
      <view class="filter-chip {{filterType === 'mechanism' ? 'active' : ''}}" bindtap="filterByType" data-type="mechanism">机制分析</view>
      <view class="filter-chip {{filterType === 'clash' ? 'active' : ''}}" bindtap="filterByType" data-type="clash">反驳思路</view>
      <view class="filter-chip {{filterType === 'question' ? 'active' : ''}}" bindtap="filterByType" data-type="question">未解问题</view>
    </scroll-view>

    <view class="empty-state" wx:if="{{records.length === 0 && !loading}}">
      <text class="empty-icon">📝</text>
      <text class="empty-text">还没有思考记录</text>
      <text class="empty-hint">点击右上角「+ 记录」开始记录你的思辨过程</text>
    </view>

    <view class="record-list">
      <view class="record-card" wx:for="{{records}}" wx:key="_id" bindtap="viewFeedback" data-record="{{item}}">
        <view class="record-top-row">
          <view class="record-tags">
            <text class="tag-chip type-{{item.content_type}}">{{item.contentTypeLabel}}</text>
            <text class="pos-chip pos-{{item.position}}">{{item.positionLabel}}</text>
          </view>
          <text class="score-badge" wx:if="{{item.recordScore != null}}">{{item.recordScore}}分</text>
          <text class="score-badge pending" wx:else>待评价</text>
        </view>
        <text class="record-title">{{item.title}}</text>
        <text class="record-preview">{{item.displayContent}}{{item.hasMoreContent ? '...' : ''}}</text>
        <view class="record-bottom-row">
          <text class="record-time">📅 {{item.displayDate}}</text>
          <text class="record-topic" wx:if="{{item.topic_title}}">📌 {{item.topic_title}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 风格分析 ===== -->
  <scroll-view class="analysis-wrap" scroll-y wx:if="{{activeTab === 'analysis'}}">
    <view class="analysis-card" wx:if="{{analysisData.styleLabel}}">
      <view class="analysis-header">
        <text class="analysis-title">🎯 辩论风格</text>
        <text class="style-badge">{{analysisData.styleLabel}}</text>
      </view>
      <text class="style-desc" wx:if="{{analysisData.styleDesc}}">{{analysisData.styleDesc}}</text>

      <view class="strength-box">
        <text class="box-label">💪 优势领域</text>
        <view class="chip-wrap">
          <text class="str-chip" wx:for="{{analysisData.strengthAreas}}" wx:key="*this">{{item}}</text>
          <text class="empty-chip" wx:if="{{analysisData.strengthAreas.length === 0}}">暂无</text>
        </view>
      </view>

      <view class="weak-box">
        <text class="box-label">📈 待提升</text>
        <view class="chip-wrap">
          <text class="weak-chip" wx:for="{{analysisData.weaknessAreas}}" wx:key="*this">{{item}}</text>
          <text class="empty-chip" wx:if="{{analysisData.weaknessAreas.length === 0}}">暂无</text>
        </view>
      </view>

      <view class="focus-box" wx:if="{{analysisData.focusText}}">
        <text class="focus-label">🎯 推荐训练方向</text>
        <text class="focus-text">{{analysisData.focusText}}</text>
      </view>

      <view class="task-box" wx:if="{{analysisData.recommendedTasks.length > 0}}">
        <text class="box-label">📚 推荐训练任务</text>
        <view class="task-row" wx:for="{{analysisData.recommendedTasks}}" wx:key="title" bindtap="goPractice">
          <text class="task-title">{{item.title}}</text>
          <text class="task-desc">{{item.description}}</text>
        </view>
      </view>

      <view class="stat-box">
        <text class="box-label">📊 统计</text>
        <view class="stat-three">
          <view class="stat-cell">
            <text class="stat-num">{{analysisData.totalRecords}}</text>
            <text class="stat-cap">总记录</text>
          </view>
          <view class="stat-cell">
            <text class="stat-num">{{analysisData.avgScore}}</text>
            <text class="stat-cap">平均分</text>
          </view>
          <view class="stat-cell">
            <text class="stat-num">{{analysisData.practiceCount}}</text>
            <text class="stat-cap">练习次数</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{!analysisData.styleLabel}}">
      <text class="empty-icon">📊</text>
      <text class="empty-text">暂无分析数据</text>
      <text class="empty-hint">提交思考记录后，AI将分析你的辩论风格并提供针对性建议</text>
    </view>
  </scroll-view>

  <!-- ===== 提交表单弹窗 ===== -->
  <view class="form-overlay" wx:if="{{showForm}}" catchtouchmove="preventDefault">
    <scroll-view class="form-modal" scroll-y enhanced show-scrollbar="{{false}}">

      <view class="form-header">
        <text class="form-title">记录思考过程</text>
        <view class="close-circle" bindtap="closeForm">
          <text class="close-x">✕</text>
        </view>
      </view>

      <view class="form-body">

        <!-- 记录类型 -->
        <view class="form-card">
          <text class="card-label">🗂 记录类型</text>
          <view class="type-grid">
            <view class="type-cell type-cell-{{item.value}} {{formData.content_type === item.value ? 'active' : ''}}"
                  wx:for="{{contentTypes}}" wx:key="value"
                  bindtap="selectType" data-value="{{item.value}}">
              <text class="type-cell-text">{{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- 立场 -->
        <view class="form-card">
          <text class="card-label">⚖️ 立场</text>
          <view class="pos-row">
            <view class="pos-cell pos-cell-pro {{formData.position === 'pro' ? 'active' : ''}}"
                  bindtap="selectPosition" data-value="pro">
              <text class="pos-icon">✅</text>
              <text class="pos-label">正方</text>
            </view>
            <view class="pos-cell pos-cell-con {{formData.position === 'con' ? 'active' : ''}}"
                  bindtap="selectPosition" data-value="con">
              <text class="pos-icon">❌</text>
              <text class="pos-label">反方</text>
            </view>
          </view>
        </view>

        <!-- 标题 -->
        <view class="form-card">
          <text class="card-label">✏️ 标题</text>
          <input class="big-input" placeholder="给这次思考起个标题"
                 value="{{formData.title}}" bindinput="inputChange" data-field="title" />
        </view>

        <!-- 辩题标题 -->
        <view class="form-card">
          <text class="card-label">🎤 辩题标题</text>
          <input class="big-input" placeholder="和哪个辩题相关？(可选)"
                 value="{{formData.topic_title}}" bindinput="inputChange" data-field="topic_title" />
        </view>

        <!-- 思考内容 -->
        <view class="form-card big-card">
          <text class="card-label">💭 思考内容</text>
          <textarea class="big-textarea"
                    placeholder="写下你的思考过程&#10;可以是完整论点、论证机制、反驳思路&#10;甚至是一个还没完全想明白的问题&#10;&#10;AI 将以专业辩论赛评委视角提供反馈与建议。"
                    value="{{formData.content}}" bindinput="inputChange" data-field="content"
                    maxlength="2000" auto-height></textarea>
          <text class="counter">{{formData.content.length}} / 2000</text>
        </view>

      </view>

      <view class="form-footer">
        <button class="ghost-btn" bindtap="closeForm">取消</button>
        <button class="primary-btn" bindtap="submitRecord" disabled="{{submitting}}">
          {{submitting ? '提交中...' : '提交给AI'}}
        </button>
      </view>

    </scroll-view>
  </view>

  <!-- ===== AI反馈详情弹窗 ===== -->
  <view class="form-overlay" wx:if="{{showFeedback}}" catchtouchmove="preventDefault">
    <scroll-view class="form-modal feedback-modal" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="form-header feedback-header">
        <text class="form-title">AI 专业评委反馈</text>
        <view class="feedback-actions">
          <button class="feedback-export-btn" bindtap="exportRecord">导出分享</button>
          <view class="close-circle" bindtap="closeFeedback">
            <text class="close-x">✕</text>
          </view>
        </view>
      </view>
      <view class="feedback-body" wx:if="{{currentRecord}}">
        <view class="fb-head">
          <text class="fb-type type-{{currentRecord.content_type}}">{{currentRecord.contentTypeLabel}}</text>
          <text class="fb-score" wx:if="{{currentRecord.recordScore != null}}">综合评分 {{currentRecord.recordScore}}/100</text>
          <text class="fb-score pending" wx:else>AI 评价中</text>
        </view>
        <text class="fb-title">{{currentRecord.title}}</text>
        <view class="fb-content-box">
          <text class="fb-content-label">我的思考</text>
          <text class="fb-content">{{currentRecord.content}}</text>
        </view>

        <view wx:if="{{currentRecord.ai_feedback}}">
          <view class="fb-section">
            <text class="fb-section-label">🌟 AI 评语</text>
            <text class="fb-section-text">{{currentRecord.ai_feedback.judge_comment}}</text>
          </view>

          <view class="fb-section">
            <text class="fb-section-label">✅ 优势</text>
            <view class="fb-list">
              <text class="fb-list-item" wx:for="{{currentRecord.aiFeedbackStrengths}}" wx:key="*this">• {{item}}</text>
            </view>
          </view>

          <view class="fb-section">
            <text class="fb-section-label">📈 待提升</text>
            <view class="fb-list">
              <text class="fb-list-item" wx:for="{{currentRecord.aiFeedbackWeaknesses}}" wx:key="*this">• {{item}}</text>
            </view>
          </view>

          <view class="fb-section">
            <text class="fb-section-label">💡 改进建议</text>
            <text class="fb-section-text">{{currentRecord.ai_feedback.suggestion}}</text>
          </view>

          <view class="fb-scores">
            <view class="fb-score-row" wx:for="{{currentRecord.aiFeedbackDims}}" wx:key="name">
              <text class="fb-score-name">{{item.name}}</text>
              <view class="fb-score-bar"><view class="fb-score-fill" style="width: {{item.percent}}%;"></view></view>
              <text class="fb-score-num">{{item.score}}/20</text>
            </view>
          </view>
        </view>

        <view class="fb-section no-data" wx:else>
          <text class="empty-icon">🤖</text>
          <text class="fb-section-text">AI 正在分析你的思考，请稍后点击右上角「…」刷新。</text>
        </view>

        <view class="comment-section">
          <text class="comment-section-title">评论交流（{{comments.length}}）</text>
          <view class="comment-loading" wx:if="{{commentsLoading}}">评论加载中...</view>
          <view class="comment-empty" wx:elif="{{comments.length === 0}}">暂时没有评论，写下你的建议吧。</view>
          <view class="comment-list" wx:else>
            <view class="comment-item" wx:for="{{comments}}" wx:key="_id">
              <view class="comment-meta">
                <text class="comment-author">{{item.nickname || '小辩手'}}</text>
                <text class="comment-date">{{item.displayDate}}</text>
              </view>
              <text class="comment-content">{{item.content}}</text>
            </view>
          </view>
          <view class="comment-compose">
            <textarea class="comment-input" value="{{commentContent}}" bindinput="commentInputChange" maxlength="300" placeholder="写下友善、具体的评论..." />
            <button class="comment-submit" bindtap="submitComment" disabled="{{commentSubmitting}}">{{commentSubmitting ? '发布中' : '发布'}}</button>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>
</view>
