.page-portfolio {
  min-height: 100vh;
  background: #f3f4f6;
  padding: 0 0 40rpx;
  box-sizing: border-box;
}

/* ===== 顶部 Tab ===== */
.top-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e5e7eb;
  box-sizing: border-box;
}

.tab-nav {
  display: flex;
  background: #f1f5f9;
  border-radius: 40rpx;
  padding: 6rpx;
  gap: 0;
}

.tab-item {
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
}

.tab-item.active {
  background: #2563eb;
  box-shadow: 0 2rpx 10rpx rgba(37, 99, 235, 0.3);
}

.tab-text {
  font-size: 26rpx;
  color: #64748b;
  display: block;
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: #ffffff;
  font-weight: 600;
}

.add-btn {
  background: #2563eb;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 30rpx;
  border-radius: 40rpx;
  border: none;
  margin: 0;
  line-height: 1.2;
}

/* ===== 过滤条 ===== */
.filter-bar {
  white-space: nowrap;
  padding: 20rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e5e7eb;
}

.filter-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #475569;
  background: #f1f5f9;
  border-radius: 32rpx;
}

.filter-chip.active {
  color: #ffffff;
  background: #3b82f6;
  font-weight: 600;
}

/* ===== 记录列表 ===== */
.record-list {
  padding: 24rpx 32rpx 40rpx;
}

.record-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
  box-sizing: border-box;
}

.record-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-tags {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.tag-chip {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 600;
}
.type-case      { background: #dbeafe; color: #1d4ed8; }
.type-argument  { background: #dcfce7; color: #15803d; }
.type-mechanism { background: #fef9c3; color: #a16207; }
.type-clash     { background: #fee2e2; color: #b91c1c; }
.type-question  { background: #f3e8ff; color: #7e22ce; }

.pos-chip {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
}
.pos-pro { background: #dcfce7; color: #166534; }
.pos-con { background: #fee2e2; color: #991b1b; }

.score-badge {
  background: #2563eb;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.score-badge.pending {
  background: #f1f5f9;
  color: #64748b;
  font-weight: 500;
}

.record-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.record-preview {
  font-size: 26rpx;
  color: #475569;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.7;
  max-height: 180rpx;
  overflow: hidden;
}

.record-bottom-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e5e7eb;
}

.record-time,
.record-topic {
  font-size: 22rpx;
  color: #94a3b8;
}

/* ===== 风格分析 ===== */
.analysis-wrap {
  padding: 24rpx 32rpx 80rpx;
  box-sizing: border-box;
  height: calc(100vh - 100rpx);
}

.analysis-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}

.analysis-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.analysis-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.style-badge {
  font-size: 26rpx;
  color: #ffffff;
  background: #2563eb;
  font-weight: 600;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
}

.style-desc {
  font-size: 26rpx;
  color: #475569;
  display: block;
  margin-bottom: 32rpx;
  line-height: 1.7;
  padding: 20rpx 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.box-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
  margin-bottom: 16rpx;
}

.strength-box,
.weak-box,
.focus-box,
.task-box,
.stat-box {
  margin-bottom: 32rpx;
}

.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.str-chip,
.weak-chip,
.empty-chip {
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.str-chip   { background: #dcfce7; color: #166534; }
.weak-chip  { background: #fef9c3; color: #a16207; }
.empty-chip { background: #f1f5f9; color: #94a3b8; }

.focus-box {
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
}

.focus-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #1d4ed8;
  display: block;
  margin-bottom: 10rpx;
}

.focus-text {
  font-size: 26rpx;
  color: #1e40af;
  line-height: 1.7;
  display: block;
}

.task-row {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 14rpx;
  border-left: 6rpx solid #2563eb;
}

.task-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
  margin-bottom: 6rpx;
}

.task-desc {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

.stat-three {
  display: flex;
  background: #f8fafc;
  border-radius: 20rpx;
  padding: 28rpx 10rpx;
}

.stat-cell {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #2563eb;
  display: block;
}

.stat-cap {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
  display: block;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 48rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #334155;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #94a3b8;
  text-align: center;
  line-height: 1.6;
}

/* ===== 表单弹窗 ===== */
.form-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.55);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.form-modal {
  width: 100%;
  max-height: 88vh;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  box-shadow: 0 -10rpx 50rpx rgba(0, 0, 0, 0.15);
}

.feedback-modal {
  border-radius: 36rpx 36rpx 0 0;
  max-height: 90vh;
}

.form-header {
  position: sticky;
  top: 0;
  z-index: 5;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 36rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e5e7eb;
}

.feedback-header {
  background: linear-gradient(135deg, #eff6ff, #e0e7ff);
}

.feedback-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.feedback-export-btn {
  margin: 0;
  padding: 12rpx 20rpx;
  min-height: auto;
  line-height: 1.2;
  border: 1rpx solid #93c5fd;
  border-radius: 12rpx;
  background: #ffffff;
  color: #1d4ed8;
  font-size: 24rpx;
}

.form-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.close-circle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-x {
  font-size: 28rpx;
  color: #64748b;
  display: block;
  line-height: 1;
}

.form-body {
  padding: 28rpx 32rpx;
}

.form-card {
  background: #f8fafc;
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 22rpx;
  box-sizing: border-box;
}

.card-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
  margin-bottom: 18rpx;
}

/* 记录类型网格 */
.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.type-cell {
  flex: 0 0 calc(50% - 7rpx);
  min-height: 90rpx;
  background: #ffffff;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 12rpx 16rpx;
}

.type-cell.active {
  border-width: 3rpx;
  background: #eff6ff;
  color: #ffffff;
}

.type-cell-text {
  font-size: 26rpx;
  color: #475569;
  font-weight: 500;
  text-align: center;
  display: block;
}

.type-cell-case      { border-top: 6rpx solid #1d4ed8; }
.type-cell-argument  { border-top: 6rpx solid #166534; }
.type-cell-mechanism { border-top: 6rpx solid #a16207; }
.type-cell-clash     { border-top: 6rpx solid #b91c1c; }
.type-cell-question  { border-top: 6rpx solid #7e22ce; }

.type-cell-case.active      { background: #dbeafe; border-color: #1d4ed8; }
.type-cell-argument.active  { background: #dcfce7; border-color: #166534; }
.type-cell-mechanism.active { background: #fef9c3; border-color: #a16207; }
.type-cell-clash.active     { background: #fee2e2; border-color: #b91c1c; }
.type-cell-question.active  { background: #f3e8ff; border-color: #7e22ce; }

.type-cell.active .type-cell-text { color: #0f172a; font-weight: 700; }

/* 立场大按钮 */
.pos-row {
  display: flex;
  gap: 18rpx;
}

.pos-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 2rpx solid #e2e8f0;
  box-sizing: border-box;
}

.pos-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 10rpx;
}

.pos-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #475569;
}

.pos-cell-pro.active {
  background: #dcfce7;
  border-color: #166534;
}
.pos-cell-con.active {
  background: #fee2e2;
  border-color: #991b1b;
}
.pos-cell-pro.active .pos-label { color: #166534; }
.pos-cell-con.active .pos-label { color: #991b1b; }

/* 输入框 */
.big-input {
  width: 100%;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
  color: #0f172a;
  min-height: 88rpx;
}

.big-card {
  padding-bottom: 20rpx;
}

.big-textarea {
  width: 100%;
  min-height: 320rpx;
  padding: 24rpx;
  font-size: 28rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
  color: #0f172a;
  line-height: 1.7;
}

.counter {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 12rpx;
}

/* 底部按钮组 */
.form-footer {
  position: sticky;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e5e7eb;
  z-index: 5;
}

.ghost-btn,
.primary-btn {
  flex: 1;
  padding: 26rpx 20rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  margin: 0;
  min-height: 88rpx;
  line-height: 1.2;
}

.ghost-btn {
  background: #f1f5f9;
  color: #475569;
}

.primary-btn {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(37, 99, 235, 0.35);
}

/* ===== AI反馈详情弹窗 ===== */
.feedback-body {
  padding: 28rpx 32rpx 60rpx;
}

.comment-section {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #e2e8f0;
}

.comment-section-title {
  display: block;
  margin-bottom: 20rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
}

.comment-loading,
.comment-empty {
  padding: 24rpx 0;
  color: #64748b;
  font-size: 25rpx;
  text-align: center;
}

.comment-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.comment-meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.comment-author {
  color: #1e3a8a;
  font-size: 25rpx;
  font-weight: 600;
}

.comment-date {
  color: #94a3b8;
  font-size: 22rpx;
}

.comment-content {
  display: block;
  color: #334155;
  font-size: 27rpx;
  line-height: 1.65;
  word-break: break-all;
}

.comment-compose {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}

.comment-input {
  flex: 1;
  min-height: 104rpx;
  padding: 16rpx;
  border: 2rpx solid #dbeafe;
  border-radius: 12rpx;
  box-sizing: border-box;
  color: #0f172a;
  font-size: 26rpx;
  line-height: 1.5;
}

.comment-submit {
  flex: 0 0 116rpx;
  margin: 0;
  padding: 18rpx 12rpx;
  min-height: 76rpx;
  border: none;
  border-radius: 12rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 1.2;
}

.fb-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
  gap: 14rpx;
}

.fb-type {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.fb-score {
  font-size: 28rpx;
  font-weight: 800;
  color: #2563eb;
  padding: 10rpx 20rpx;
  background: #dbeafe;
  border-radius: 24rpx;
}

.fb-score.pending {
  color: #64748b;
  background: #f1f5f9;
  font-weight: 600;
}

.fb-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #0f172a;
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.fb-content-box {
  background: #f8fafc;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.fb-content-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #64748b;
  display: block;
  margin-bottom: 10rpx;
}

.fb-content {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.8;
  white-space: pre-wrap;
  display: block;
}

.fb-section {
  margin-bottom: 28rpx;
}

.fb-section-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
  margin-bottom: 14rpx;
}

.fb-section-text {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.8;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  display: block;
}

.fb-list {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx 20rpx 20rpx 32rpx;
}

.fb-list-item {
  font-size: 26rpx;
  color: #334155;
  line-height: 2;
  display: list-item;
  display: block;
}

.fb-scores {
  background: #f8fafc;
  border-radius: 20rpx;
  padding: 24rpx;
}

.fb-score-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 14rpx;
}
.fb-score-row:last-child { margin-bottom: 0; }

.fb-score-name {
  width: 120rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #334155;
  flex-shrink: 0;
}

.fb-score-bar {
  flex: 1;
  height: 14rpx;
  background: #e2e8f0;
  border-radius: 7rpx;
  overflow: hidden;
}

.fb-score-fill {
  height: 100%;
  background: linear-gradient(90deg, #3b82f6, #2563eb);
  border-radius: 7rpx;
}

.fb-score-num {
  width: 110rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 700;
  color: #2563eb;
  flex-shrink: 0;
}

.fb-section.no-data {
  padding: 60rpx 20rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  background: #f8fafc;
  border-radius: 20rpx;
}

.fb-section.no-data .fb-section-text {
  background: transparent;
  padding: 0;
  text-align: center;
}

/* ===== 加载中 ===== */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #e2e8f0;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
