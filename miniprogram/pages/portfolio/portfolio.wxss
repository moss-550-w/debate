.page-portfolio {
  padding: 0;
  min-height: 100vh;
  background: #f0f2f5;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: white;
  border-bottom: 1rpx solid #e5e7eb;
}

.tab-nav {
  display: flex;
  gap: 20rpx;
}

.tab-item {
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  color: #6b7280;
  border-radius: 40rpx;
}

.tab-item.active {
  color: #2563eb;
  background: #dbeafe;
  font-weight: 600;
}

.add-btn {
  background: #2563eb;
  color: white;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  border: none;
  line-height: 1.4;
}

.filter-bar {
  white-space: nowrap;
  padding: 16rpx 30rpx;
  background: white;
  border-bottom: 1rpx solid #e5e7eb;
}

.filter-item {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 30rpx;
}

.filter-item.active {
  color: #2563eb;
  background: #dbeafe;
  font-weight: 500;
}

.record-list {
  padding: 20rpx;
}

.record-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.record-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.record-type {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.type-case { background: #dbeafe; color: #1e40af; }
.type-argument { background: #d1fae5; color: #065f46; }
.type-mechanism { background: #fef3c7; color: #92400e; }
.type-clash { background: #fee2e2; color: #991b1b; }
.type-question { background: #f3e8ff; color: #6b21a8; }

.record-position {
  font-size: 22rpx;
  color: #6b7280;
}

.record-score {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: bold;
  color: #2563eb;
}

.record-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  display: block;
  margin-bottom: 8rpx;
}

.record-preview {
  font-size: 26rpx;
  color: #6b7280;
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.6;
}

.record-time {
  font-size: 22rpx;
  color: #9ca3af;
}

/* 风格分析 */
.analysis-section {
  padding: 20rpx;
}

.analysis-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.analysis-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.analysis-title {
  font-size: 30rpx;
  font-weight: bold;
}

.analysis-style {
  font-size: 26rpx;
  color: #2563eb;
  font-weight: 600;
  padding: 8rpx 20rpx;
  background: #dbeafe;
  border-radius: 30rpx;
}

.style-desc {
  font-size: 26rpx;
  color: #6b7280;
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.strength-tag {
  padding: 8rpx 20rpx;
  background: #d1fae5;
  color: #065f46;
  font-size: 24rpx;
  border-radius: 30rpx;
}

.weakness-tag {
  padding: 8rpx 20rpx;
  background: #fef3c7;
  color: #92400e;
  font-size: 24rpx;
  border-radius: 30rpx;
}

.empty-tag {
  padding: 8rpx 20rpx;
  background: #f3f4f6;
  color: #9ca3af;
  font-size: 24rpx;
  border-radius: 30rpx;
}

.focus-card {
  background: #eff6ff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.focus-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e40af;
  display: block;
  margin-bottom: 8rpx;
}

.focus-text {
  font-size: 26rpx;
  color: #3b82f6;
  line-height: 1.6;
}

.tasks-section {
  margin-bottom: 24rpx;
}

.task-item {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.task-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
  display: block;
  margin-bottom: 4rpx;
}

.task-desc {
  font-size: 24rpx;
  color: #6b7280;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #2563eb;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #6b7280;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #9ca3af;
  text-align: center;
}

/* 表单弹窗 */
.form-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.form-modal {
  background: white;
  border-radius: 30rpx 30rpx 0 0;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
}

.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #e5e7eb;
}

.form-title {
  font-size: 34rpx;
  font-weight: bold;
}

.form-close {
  font-size: 40rpx;
  color: #9ca3af;
  padding: 10rpx;
}

.form-body {
  padding: 30rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  display: block;
  margin-bottom: 12rpx;
}

.select-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.select-item {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 30rpx;
}

.select-item.active {
  color: #2563eb;
  background: #dbeafe;
  font-weight: 600;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  font-size: 28rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 240rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.form-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx 40rpx;
}

.cancel-btn, .submit-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.cancel-btn {
  background: #f3f4f6;
  color: #6b7280;
  border: none;
}

.submit-btn {
  background: #2563eb;
  color: white;
  border: none;
}

/* 加载中 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e5e7eb;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}