<view class="page-sparring">

  <!-- 选择阶段 -->
  <view class="select-phase" wx:if="{{step === 'select'}}">
    <text class="section-title">选择对手风格</text>
    <view class="style-list">
      <view class="style-card {{selectedStyle === item.id ? 'selected' : ''}}" wx:for="{{STYLE_LIST}}" wx:key="id" bindtap="selectStyle" data-style="{{item.id}}">
        <text class="style-icon">{{item.icon}}</text>
        <text class="style-name">{{item.name}}</text>
        <text class="style-desc">{{item.description}}</text>
      </view>
    </view>

    <text class="section-title">选择辩题</text>
    <view class="topic-toolbar">
      <input class="topic-search" value="{{topicKeyword}}" bindinput="topicKeywordChange" placeholder="搜索辩题关键词" confirm-type="search" />
      <button class="clear-search" wx:if="{{topicKeyword}}" bindtap="clearTopicKeyword">清除</button>
    </view>
    <view class="topic-count">共 {{TOPIC_LIST.length}} 道辩题<text wx:if="{{topicKeyword}}">，匹配 {{displayTopics.length}} 道</text></view>
    <view class="topic-list">
      <view class="topic-loading" wx:if="{{topicsLoading}}">正在加载辩题...</view>
      <view class="topic-item {{selectedTopicId === item.id ? 'active' : ''}}" wx:for="{{displayTopics}}" wx:key="id" bindtap="selectTopic" data-topic="{{item}}">
        <text class="topic-title">{{item.title}}</text>
        <text class="topic-source">{{item.source}}</text>
      </view>
      <view class="topic-empty" wx:if="{{!topicsLoading && displayTopics.length === 0}}">没有找到匹配的辩题，请换个关键词。</view>
    </view>

    <button class="start-btn" bindtap="startBattle">开始对练</button>
  </view>

  <!-- 对练阶段 -->
  <view class="battle-phase" wx:if="{{step === 'battle'}}">
    <view class="battle-header">
      <view class="opponent-info">
        <text class="opponent-icon">{{opponent.icon}}</text>
        <view class="opponent-detail" bindtap="showTopicDetail">
          <text class="opponent-name">{{opponent.name}}</text>
          <text class="battle-topic">{{battleTopic}}</text>
          <text class="topic-detail-link">查看完整辩题</text>
        </view>
      </view>
      <button class="end-btn" bindtap="endBattle">结束</button>
    </view>

    <!-- 调试信息：消息数量显示 -->
    <view class="debug-strip" wx:if="{{debugMsgCount >= 0}}">消息数：{{debugMsgCount}}</view>

    <!-- 语音识别状态条（全程可见） -->
    <view class="voice-bar voice-bar-{{voiceStep}}" wx:if="{{voiceStep !== 'idle' && voiceStatusText}}">
      <text class="voice-bar-text">{{voiceStatusText}}</text>
    </view>

    <!-- 显式高度的消息区（绝对关键！） -->
    <scroll-view class="message-list" scroll-y style="height: {{scrollViewHeight}}px;" scroll-with-animation scroll-into-view="msg-{{debugMsgCount}}">
      <view class="message-wrap" wx:for="{{messages}}" wx:for-item="msg" wx:for-index="midx" wx:key="midx" id="msg-{{midx + 1}}">
        <view class="msg-row msg-row-{{msg.role}}">
          <view class="bubble bubble-{{msg.role}}">
            <text class="tag" wx:if="{{msg.role === 'ai' && msg.styleName}}">{{msg.styleName}}</text>
            <text class="txt">{{msg.content}}</text>
          </view>
        </view>
      </view>
      <view style="height: 40rpx;"></view>
    </scroll-view>

    <view class="stats-bar">
      <view class="stat-entry">
        <text class="stat-value">{{statsDisplay.totalRounds}}</text>
        <text class="stat-label">轮次</text>
      </view>
      <view class="stat-entry">
        <text class="stat-value">{{statsDisplay.effectiveRate}}</text>
        <text class="stat-label">有效反驳</text>
      </view>
      <view class="stat-entry">
        <text class="stat-value">{{statsDisplay.stallCount}}</text>
        <text class="stat-label">卡壳</text>
      </view>
    </view>

    <view class="input-bar">
      <textarea class="msg-input" placeholder="输入你的论点，或使用语音后校正识别结果..." value="{{userInput}}" bindinput="inputChange" focus="{{textInputFocused}}" auto-height maxlength="500" show-confirm-bar="false" disabled="{{sending}}" />
      <view class="input-actions">
        <button class="voice-btn voice-btn-{{recording ? 'on' : voiceStep}}"
                bindtap="toggleRecord"
                hover-class="none">
          <text class="voice-icon">{{recording ? '🔴' : '🎤'}}</text>
        </button>
        <button class="send-btn" bindtap="sendMessage" disabled="{{sending}}">{{sending ? '发送中' : '发送'}}</button>
      </view>
    </view>
  </view>

  <!-- 结果阶段 -->
  <view class="result-phase" wx:if="{{step === 'result'}}">
    <view class="result-card">
      <text class="result-title">对练结束</text>
      <text class="result-subtitle">与 {{opponent.name}} 的对练数据</text>
      <view class="result-stats">
        <view class="result-stat-item">
          <text class="result-stat-value">{{statsDisplay.totalRounds}}</text>
          <text class="result-stat-label">总轮次</text>
        </view>
        <view class="result-stat-item">
          <text class="result-stat-value">{{statsDisplay.effectiveRate}}</text>
          <text class="result-stat-label">有效反驳率</text>
        </view>
        <view class="result-stat-item">
          <text class="result-stat-value">{{statsDisplay.stallCount}}</text>
          <text class="result-stat-label">卡壳次数</text>
        </view>
      </view>
      <view class="result-actions">
        <button class="primary-btn" bindtap="restartBattle">再来一次</button>
        <button class="outline-btn" bindtap="goBack">返回</button>
      </view>
    </view>
  </view>

  <view class="topic-modal-mask" wx:if="{{showTopicModal}}" catchtap="closeTopicDetail">
    <view class="topic-modal" catchtap="stopPropagation">
      <text class="topic-modal-label">当前辩题</text>
      <text class="topic-modal-title">{{battleTopic}}</text>
      <view class="topic-modal-actions">
        <button class="topic-copy-btn" bindtap="copyBattleTopic">复制辩题</button>
        <button class="topic-close-btn" bindtap="closeTopicDetail">返回对练</button>
      </view>
    </view>
  </view>
</view>
