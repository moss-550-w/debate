.page-tournament {
  padding: 0;
  min-height: 100vh;
  background: #f0f2f5;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: white;
  border-bottom: 1rpx solid #e5e7eb;
}

.page-title {
  font-size: 34rpx;
  font-weight: bold;
}

.match-btn {
  background: #f59e0b;
  color: white;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  border: none;
}

.tournament-list {
  padding: 20rpx;
}

.tournament-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.t-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.t-name {
  font-size: 30rpx;
  font-weight: bold;
}

.t-format {
  font-size: 22rpx;
  color: #2563eb;
  padding: 4rpx 16rpx;
  background: #dbeafe;
  border-radius: 20rpx;
}

.t-info {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.t-info-item {
  font-size: 24rpx;
  color: #6b7280;
}

.t-status {
  margin-left: auto;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.status-open { background: #d1fae5; color: #065f46; }
.status-closed { background: #fee2e2; color: #991b1b; }

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  background: white;
  border-radius: 30rpx 30rpx 0 0;
  width: 100%;
  max-height: 85vh;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #e5e7eb;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
}

.modal-close {
  font-size: 40rpx;
  color: #9ca3af;
  padding: 10rpx;
}

.modal-body {
  flex: 1;
  min-height: 0;
  padding: 30rpx;
  overflow-y: auto;
}

.modal-footer {
  padding: 20rpx 30rpx 40rpx;
}

.detail-section {
  margin-bottom: 30rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.detail-label {
  font-size: 26rpx;
  color: #6b7280;
}

.detail-value {
  font-size: 28rpx;
  font-weight: 500;
}

.teams-title {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.team-card {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.team-name {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.team-members {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.member-tag {
  padding: 6rpx 16rpx;
  background: #dbeafe;
  color: #1e40af;
  font-size: 22rpx;
  border-radius: 20rpx;
}

.empty-teams {
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 40rpx;
}

.register-btn {
  background: #2563eb;
  color: white;
  font-size: 30rpx;
  padding: 22rpx;
  border-radius: 40rpx;
  border: none;
  width: 100%;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.form-input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  line-height: 76rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  box-sizing: border-box;
  margin-bottom: 12rpx;
  background: #fff;
}

.form-input::placeholder {
  color: #9ca3af;
}

.style-select {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.style-option {
  box-sizing: border-box;
  min-height: 52rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  line-height: 36rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 20rpx;
}

.style-option.active {
  color: #2563eb;
  background: #dbeafe;
  font-weight: 500;
}

.member-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.add-member-btn, .remove-member-btn {
  flex: 1;
  min-width: 0;
  padding: 16rpx;
  font-size: 26rpx;
  border-radius: 30rpx;
  border: none;
}

.add-member-btn[disabled], .remove-member-btn[disabled] {
  opacity: .45;
}

.add-member-btn {
  background: #dbeafe;
  color: #2563eb;
}

.remove-member-btn {
  background: #fee2e2;
  color: #ef4444;
}

/* 组队推荐 */
.style-show {
  text-align: center;
  padding: 30rpx;
  background: #eff6ff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.style-show-label {
  font-size: 24rpx;
  color: #6b7280;
  display: block;
  margin-bottom: 8rpx;
}

.style-show-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #2563eb;
}

.recommend-title {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.recommend-card {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.recommend-style {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 4rpx;
}

.recommend-score {
  font-size: 24rpx;
  color: #10b981;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.recommend-reason {
  font-size: 24rpx;
  color: #6b7280;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #6b7280;
  font-weight: 500;
}

.empty-hint {
  font-size: 26rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

/* 加载中 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e5e7eb;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
