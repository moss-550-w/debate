.page-profile { padding: 20rpx; background: #f1f5f9; min-height: 100vh; color: #172033; }
.user-header, .radar-section, .stats-section, .coach-section, .history-section, .speech-section { background: #fff; border-radius: 18rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, .05); }
.user-header { display: flex; align-items: center; padding: 28rpx; color: #fff; background: #1d4ed8; }
.avatar { width: 88rpx; height: 88rpx; border-radius: 50%; background: rgba(255,255,255,.2); display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: 700; }
.user-meta { flex: 1; margin-left: 20rpx; min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.eyebrow { font-size: 22rpx; color: rgba(255,255,255,.75); }
.nickname { font-size: 36rpx; font-weight: 700; }
.grade { font-size: 23rpx; color: rgba(255,255,255,.78); }
.overall-score { width: 122rpx; text-align: center; border-left: 1rpx solid rgba(255,255,255,.25); padding-left: 16rpx; }
.overall-number { display: block; font-size: 46rpx; font-weight: 700; line-height: 1.1; }
.overall-label { display: block; margin-top: 5rpx; font-size: 21rpx; color: rgba(255,255,255,.78); }
.radar-section, .stats-section, .coach-section, .history-section, .speech-section { padding: 26rpx; }
.section-heading { display: flex; align-items: flex-start; justify-content: space-between; }
.section-title { display: block; font-size: 30rpx; font-weight: 700; }
.section-subtitle { display: block; margin-top: 6rpx; color: #64748b; font-size: 22rpx; }
.data-state, .speech-total { color: #2563eb; font-size: 22rpx; }
.data-state.muted { color: #94a3b8; }
.radar-container { width: 100%; height: 430rpx; display: flex; align-items: center; justify-content: center; }
.radar-canvas { width: 100%; height: 100%; }
.dimension-list { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx 24rpx; }
.dimension-topline { display: flex; justify-content: space-between; color: #475569; font-size: 22rpx; margin-bottom: 8rpx; }
.dimension-track { height: 10rpx; background: #e2e8f0; border-radius: 8rpx; overflow: hidden; }
.dimension-fill { height: 100%; min-width: 0; background: #2563eb; border-radius: inherit; }
.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-top: 22rpx; }
.stat-item { text-align: center; min-width: 0; }
.stat-value { display: block; color: #1d4ed8; font-size: 34rpx; font-weight: 700; white-space: nowrap; }
.stat-label { display: block; margin-top: 5rpx; color: #64748b; font-size: 20rpx; white-space: nowrap; }
.recommendation-item { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #e2e8f0; }
.recommendation-index { width: 38rpx; height: 38rpx; flex: 0 0 38rpx; border-radius: 50%; background: #dbeafe; color: #1d4ed8; text-align: center; line-height: 38rpx; font-size: 22rpx; font-weight: 700; }
.recommendation-copy { flex: 1; min-width: 0; }
.recommendation-title, .recommendation-desc { display: block; }
.recommendation-title { font-size: 26rpx; font-weight: 600; }
.recommendation-desc { margin-top: 5rpx; color: #64748b; font-size: 22rpx; line-height: 1.45; }
.history-list { margin-top: 18rpx; }
.history-item { display: flex; align-items: center; gap: 14rpx; padding: 17rpx 0; border-top: 1rpx solid #e2e8f0; }
.history-type { padding: 7rpx 12rpx; border-radius: 8rpx; font-size: 21rpx; white-space: nowrap; }
.type-portfolio { background: #dbeafe; color: #1d4ed8; }
.type-debate { background: #dcfce7; color: #15803d; }
.history-info { flex: 1; min-width: 0; }
.history-title { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 25rpx; }
.history-score { display: block; margin-top: 4rpx; color: #475569; font-size: 21rpx; }
.history-date { color: #94a3b8; font-size: 21rpx; white-space: nowrap; }
.empty-tip { padding: 34rpx 12rpx 12rpx; color: #64748b; text-align: center; font-size: 24rpx; line-height: 1.5; }
.speech-section { background: #f8fafc; box-shadow: none; border: 1rpx solid #e2e8f0; }
.speech-stats { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 22rpx; text-align: center; }
.speech-value, .speech-label { display: block; }
.speech-value { color: #475569; font-size: 30rpx; font-weight: 700; }
.speech-label { margin-top: 5rpx; color: #64748b; font-size: 21rpx; }
