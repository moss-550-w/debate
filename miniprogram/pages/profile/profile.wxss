.page-profile {
  padding: 20rpx;
  background: #f0f2f5;
  min-height: 100vh;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

/* 用户头部 */
.user-header {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: white;
  font-weight: bold;
}

.user-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname {
  font-size: 36rpx;
  color: white;
  font-weight: bold;
}

.grade {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

/* 雷达图 */
.radar-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.radar-container {
  width: 100%;
  height: 480rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.radar-canvas {
  width: 100%;
  height: 100%;
}

.radar-legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot.baseline { background: #9ca3af; }
.legend-dot.latest { background: #2563eb; }

/* 统计 */
.stats-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #2563eb;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

/* 历史记录 */
.history-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.history-type {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.type-argument { background: #dbeafe; color: #2563eb; }
.type-speech { background: #d1fae5; color: #065f46; }

.history-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
}

.history-score {
  font-size: 26rpx;
  font-weight: 500;
}

.history-date {
  font-size: 24rpx;
  color: #6b7280;
}

.empty-tip {
  text-align: center;
  padding: 40rpx;
  color: #6b7280;
  font-size: 26rpx;
}
